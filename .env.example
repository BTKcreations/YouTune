# ==========================================
# YouTune Environment Configuration
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Default fallback uses SQLite when DATABASE_URL is not set or in local mode:
# DATABASE_URL=sqlite+aiosqlite:///./youtune.db
# For Docker Compose / PostgreSQL:
DATABASE_URL=postgresql+asyncpg://youtune:youtune_password@postgres:5432/youtune_db

# Postgres Docker environment variables
POSTGRES_USER=youtune
POSTGRES_PASSWORD=youtune_password
POSTGRES_DB=youtune_db
POSTGRES_PORT=5432

# ------------------------------------------
# Security & JWT Authentication
# ------------------------------------------
# Generate a strong 32+ character random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=youtune_super_secret_jwt_key_change_in_production_32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------
# YouTube Data API v3 Configuration
# ------------------------------------------
# If omitted or left empty, YouTune automatically uses high-fidelity mock/fallback data
# to guarantee seamless local development without quota limits or errors.
YOUTUBE_API_KEY=

# Cache TTL in seconds for YouTube responses (Default: 3600 = 1 hour)
YOUTUBE_CACHE_TTL_SECONDS=3600

# ------------------------------------------
# Frontend Client Environment
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
